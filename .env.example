# PostgreSQL connection string. Any Postgres 14+ works (Neon, Supabase, RDS, Railway, local…).
# For local development run `npm run db:local` which boots an embedded PostgreSQL on this URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public base URL of the deployment (used for links in public portfolio pages).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: comma-separated list of extra origins allowed to call Server Actions
# when the app runs behind a reverse proxy (e.g. "*.example.com,app.example.com").
# ALLOWED_ORIGINS=
